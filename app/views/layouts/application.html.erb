<!DOCTYPE html>
<html>
  <head>
    <title>Job Application Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="navbar">
      <%= link_to "Job Application Tracker", root_path, class: "brand" %>
      <nav>
        <% if logged_in? %>
          <%= link_to "Dashboard", root_path %>
          <%= link_to "Applications", applications_path %>
          <span class="current-user"><%= current_user.email %></span>
          <%= button_to "Log out", session_path, method: :delete, class: "link-button" %>
        <% else %>
          <%= link_to "Log in", login_path %>
          <%= link_to "Sign up", signup_path %>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
